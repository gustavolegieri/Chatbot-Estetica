GATE_API_URL=https://chatbot-estetica-ten.vercel.app/api/admin/gate-vision
GATE_DEVICE_TOKEN=cole-aqui-o-token-do-dispositivo
GATE_DEVICE_ID=portao-principal
GATE_CAMERA_NAME=Webcam do portao

# 0 = primeira webcam USB. Para câmera IP, informe a URL RTSP.
GATE_CAMERA_SOURCE=0
GATE_CAMERA_WIDTH=1920
GATE_CAMERA_HEIGHT=1080
GATE_CAMERA_FPS=30
GATE_MODEL=yolov8n.pt
GATE_CONFIDENCE=0.45
GATE_PROCESS_FPS=3
# O OCR preserva 1920x1080; somente o YOLO usa esta cópia leve.
GATE_DETECTION_WIDTH=768
GATE_MODEL_IMAGE_SIZE=512
GATE_CPU_THREADS=4
# 0 usa a otimização automática do PyTorch para o processador local.
GATE_TORCH_THREADS=0

# Uma unica linha sobre a risca fisica do portao, entre 0 e 1.
GATE_LINE=0.58
# Pequena margem invisivel para evitar eventos repetidos por tremor.
GATE_LINE_HYSTERESIS=0.025

GATE_SHOW_PREVIEW=true
GATE_SEND_SNAPSHOTS=true
# Ative se a rua aparecer na parte inferior da imagem.
GATE_FLIP_VERTICAL=false
GATE_HEARTBEAT_SECONDS=60
GATE_TRACK_TTL_SECONDS=6
GATE_EVENT_COOLDOWN_SECONDS=25

# OCR local da placa brasileira (padrao antigo e Mercosul).
GATE_PLATE_OCR_ENABLED=true
GATE_PLATE_OCR_MIN_CONFIDENCE=0.30
GATE_PLATE_SCAN_INTERVAL=0.6
GATE_PLATE_EVENT_WAIT_SECONDS=10
# A placa só é confirmada quando a mesma leitura aparece em mais de um quadro.
GATE_PLATE_CONFIRM_READS=2
GATE_PLATE_MAX_READS=7
GATE_PLATE_SINGLE_HIGH_CONFIDENCE=0.88
GATE_DETECTION_DISPLAY_TTL_SECONDS=5
GATE_PRESENCE_RECOVERY_SECONDS=4
# Caixa estabilizada: menor valor = menos tremor quando o carro esta parado.
GATE_BOX_SMOOTHING_STILL=0.12
# Resposta mais rapida quando o carro realmente esta em movimento.
GATE_BOX_SMOOTHING_MOVING=0.42

# Timelapse curto sem desfoque: preserva integralmente o quadro capturado.
GATE_TIMELAPSE_ENABLED=true
GATE_TIMELAPSE_INTERVAL_SECONDS=30
GATE_TIMELAPSE_MAX_FRAMES=300
GATE_TIMELAPSE_FPS=12
GATE_TIMELAPSE_MAX_BYTES=2400000

# Acompanhamento privado e gratuito via WebRTC (video direto, sem audio).
GATE_LIVE_ENABLED=true
# Se vazio, e derivado automaticamente de GATE_API_URL.
# GATE_LIVE_API_URL=https://seu-app.vercel.app/api/gate-live/device
GATE_LIVE_FPS=8
GATE_LIVE_WIDTH=960
