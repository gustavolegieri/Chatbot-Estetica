# Banco — Supabase + Vercel: ver docs/SUPABASE-VERCEL.md
# Runtime (app + Vercel): porta 6543 no host db.*.supabase.co
# Vercel (IPv4): pooler — postgres.SEU_REF @ aws-*-REGIAO.pooler.supabase.com:6543
# Para serverless com pooler, connection_limit=2 é recomendado (evita esgotamento)
# DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2&sslmode=require
# PC migrations: DIRECT_URL=postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estetica_automotiva?schema=public"

# Autenticação (gere com: openssl rand -base64 32)
JWT_SECRET="sua-chave-secreta-muito-segura-aqui"

# URL pública da aplicação (webhooks WhatsApp)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WasenderAPI (WhatsApp) — Substitui Evolution API
# Obtenha sua chave em: https://wasenderapi.com
WASENDER_API_KEY="sua-chave-wasender-api"
# Plano pago: 350 ms mantém as respostas em sequência sem o atraso do plano de teste.
# Se a proteção de conta da WASender estiver ativa, use 5000.
WASENDER_MIN_SEND_GAP_MS="350"

# Evolution API (legado) — pode ser removido se usar WasenderAPI
# EVOLUTION_API_URL="http://localhost:8080"
# EVOLUTION_API_KEY="sua-api-key"
# EVOLUTION_INSTANCE_NAME="estetica"

# Cron de lembretes 24h (chame GET /api/cron/reminders a cada hora)
CRON_SECRET="gere-uma-chave-aleatoria"

# API Key para integração n8n (header x-api-key nas rotas /api/n8n/*)
# Gere com: openssl rand -base64 32
N8N_API_KEY=""

# API Key do servidor MCP para o agente n8n (Authorization: Bearer <chave>)
# Gere com: openssl rand -base64 32 — pode ser diferente de N8N_API_KEY
N8N_MCP_API_KEY=""

# Cerebras AI — interpretação de mensagens e respostas a dúvidas no WhatsApp
CEREBRAS_API_KEY="sua-chave-cerebras"
CEREBRAS_MODEL="gpt-oss-120b"

# Áudio no WhatsApp — Groq transcreve; Edge TTS gera voz PT-BR sem chave Azure
GROQ_API_KEY="sua-chave-groq"
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"
GROQ_TRANSCRIPTION_TIMEOUT_MS="15000"
WHATSAPP_AUDIO_DECRYPT_TIMEOUT_MS="8000"
WHATSAPP_VOICE_REPLIES_ENABLED="true"
WHATSAPP_TTS_VOICE="pt-BR-AntonioNeural"
WHATSAPP_TTS_RATE="+2%"
WHATSAPP_TTS_PITCH="+0Hz"
WHATSAPP_TTS_TIMEOUT_MS="8000"

# Distance Matrix Dashboard
DISTANCEMATRIX_API_KEY="sua-chave-distance-matrix"
# Compatibilidade com a antiga variável
GOOGLE_MAPS_API_KEY="sua-chave-google-maps"

# Cloudinary (upload de imagens para WhatsApp)
# Obtenha suas credenciais em: https://cloudinary.com/console
# Configure upload preset unsigned no painel do Cloudinary
CLOUDINARY_CLOUD_NAME="seu-cloud-name-aqui"
CLOUDINARY_API_KEY="sua-api-key-aqui"
CLOUDINARY_API_SECRET="sua-api-secret-aqui"
CLOUDINARY_UPLOAD_PRESET="unsigned_preset"

# HubSpot Forms — sincronização opcional da captação pública
# Publique o formulário no portal e copie o GUID da URL ou do código incorporado.
HUBSPOT_PORTAL_ID="51824457"
HUBSPOT_FORM_GUID=""

# Web Push do aplicativo instalável. O sistema usa JWT_SECRET como fallback seguro.
# Opcional: defina um par VAPID próprio para manter as inscrições ao trocar JWT_SECRET.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@garagemdoka.com.br"

# Portão IA — use o mesmo token em camera-agent/.env e na Vercel.
# Gere um valor longo e aleatório. A webcam envia apenas eventos, nunca o vídeo.
GATE_VISION_DEVICE_TOKEN=""
